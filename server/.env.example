# ─── Anther Consulting — Server environment variables ─────────────────────────
# Copy this file to .env and fill in the values. NEVER commit .env.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development   # change to "production" on your hosting platform

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Dev:  http://localhost:5173
# Prod: https://antherconsulting.com.ng,https://www.antherconsulting.com.ng
CLIENT_ORIGIN=http://localhost:5173

# Admin panel origin — /api/admin requests from other origins return 404 in prod.
# Set to your admin deployment URL e.g. https://admin.antherconsulting.com.ng
# Leave blank in development (no restriction applied).
ADMIN_ORIGIN=

# ── SMTP / Nodemailer ─────────────────────────────────────────────────────────
# Leave ALL of these blank in development — the server will automatically use
# Ethereal (https://ethereal.email) as a fake SMTP and log a preview URL.
#
# For production, fill these in with your mail provider's settings.
#
# ┌─────────────────────────────────────────────────────────┐
# │  PROVIDER QUICK REFERENCE                               │
# │                                                         │
# │  antherconsulting.com.ng hosting (current):             │
# │    SMTP_HOST=mail.antherconsulting.com.ng               │
# │    SMTP_PORT=465                                        │
# │    SMTP_SECURE=true                                     │
# │    SMTP_USER=info2@antherconsulting.com.ng              │
# │    SMTP_PASS=your-email-password                        │
# │                                                         │
# │  Gmail (App Password required):                         │
# │    SMTP_HOST=smtp.gmail.com                             │
# │    SMTP_PORT=587                                        │
# │    SMTP_SECURE=false                                    │
# │    SMTP_USER=you@gmail.com                              │
# │    SMTP_PASS=your-16-char-app-password                  │
# └─────────────────────────────────────────────────────────┘

SMTP_HOST=mail.antherconsulting.com.ng
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info2@antherconsulting.com.ng
SMTP_PASS=

# "From" address that appears in outgoing emails
MAIL_FROM=Anther Consulting <info@antherconsulting.com.ng>

# Where contact-form submissions are delivered (usually same as SMTP_USER)
CONTACT_RECIPIENT=info@antherconsulting.com.ng

# ── Database (add when ready to move off JSON file storage) ──────────────────
# MongoDB Atlas example:
#   DATABASE_URL=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/anther?retryWrites=true&w=majority
#
# PostgreSQL example:
#   DATABASE_URL=postgresql://user:password@host:5432/anther
#
DATABASE_URL=
