# ─── Anther Consulting — Client environment variables ─────────────────────────
#
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to source control.

# Backend API base URL.
# Development: leave blank — Vite proxy handles /api/* → localhost:5000
# Production (separate deployments): set to your deployed backend URL
# e.g. https://anther-api.onrender.com
VITE_API_URL=

# Canonical site URL for SEO meta tags and sitemap
# e.g. https://antherconsulting.com.ng
VITE_SITE_URL=https://antherconsulting.com.ng

# ── Admin panel access control ────────────────────────────────────────────────
# Controls whether the /admin route is compiled and accessible in this build.
#
# PUBLIC build  (Vercel — main website):   VITE_ADMIN_ENABLED=false
#   → /admin returns a 404. Admin code is excluded from the bundle.
#
# ADMIN build   (separate Vercel project): VITE_ADMIN_ENABLED=true
#   → /admin serves the login + dashboard.
#   → Set VITE_API_URL to your backend URL as well.
#
VITE_ADMIN_ENABLED=false
