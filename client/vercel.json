{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "admin.antherconsulting.com.ng" }],
      "destination": "/admin/login",
      "permanent": false
    },
    {
      "source": "/((?!admin).*)",
      "has": [{ "type": "host", "value": "admin.antherconsulting.com.ng" }],
      "destination": "/admin/login",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
