{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "admin.antherconsulting.com.ng" }],
      "destination": "/admin/login",
      "permanent": false
    },
    {
      "source": "/((?!admin|assets|registerSW\\.js|manifest\\.webmanifest|sw\\.js|workbox|favicon|robots|sitemap|icons|pwa).*)",
      "has": [{ "type": "host", "value": "admin.antherconsulting.com.ng" }],
      "destination": "/admin/login",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/|registerSW\\.js|manifest\\.webmanifest|sw\\.js|workbox|favicon|robots\\.txt|sitemap\\.xml|icons|pwa).*)",
      "destination": "/index.html"
    }
  ]
}
